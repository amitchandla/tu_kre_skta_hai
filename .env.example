# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. NEVER expose to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI provider (required for Growth Advisor text, AI Help, captions, video scripts) ---
# Used only inside server routes under /app/api/**. Never exposed to the client.
ANTHROPIC_API_KEY=

# --- AI Video Studio (optional, feature stays OFF until set) ---
VIDEO_GENERATION_API_KEY=
VIDEO_GENERATION_PROVIDER=

# --- Meta Ads / WhatsApp (optional, feature stays OFF until set) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# --- Razorpay (optional, prepared for future billing) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
